rules_version = '2';
// قواعد أمان Firestore لنظام مبيعات عز النخبة.
// المالك: mamdouh.rezkallah95@gmail.com — الصق الملف ده كامل في Firestore → Rules واضغط Publish.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null && request.auth.token.email_verified == true; }
    function email() { return request.auth.token.email.lower(); }
    function isOwner() { return signedIn() && email() == 'mamdouh.rezkallah95@gmail.com'; }
    function hasRoles() { return exists(/databases/$(database)/documents/meta/roles); }
    function roles() { return get(/databases/$(database)/documents/meta/roles).data; }
    function isEditor() { return isOwner() || (signedIn() && hasRoles() && email() in roles().editors); }
    function isViewer() { return isEditor() || (signedIn() && hasRoles() && email() in roles().viewers); }

    // قائمة الصلاحيات: الكل المصرّح له يقراها، والمالك بس يعدّلها
    match /meta/roles {
      allow read: if isViewer();
      allow write: if isOwner();
    }
    // كل بيانات النظام: الاطلاع للمصرّح لهم، والتعديل لأصحاب صلاحية التعديل
    match /{col}/{id} {
      allow read: if isViewer();
      allow write: if isEditor() && !(col == 'meta' && id == 'roles');
    }
  }
}
